{
	"name": "@gospeak/plugin-sdk",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"copy:proto": "node ./scripts/copy-proto.mjs",
		"build": "pnpm copy:proto && tsc",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"test": "pnpm copy:proto && vitest run",
		"check": "biome check",
		"format": "biome format --write"
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.14.2",
		"@grpc/proto-loader": "^0.8.0"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
